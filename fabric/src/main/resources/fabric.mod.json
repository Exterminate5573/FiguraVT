    "main": [
      "dev.exterminate.figuravt.fabric.ExamplePluginFabric"
    ],
    "figura_api": [
      "dev.exterminate.figuravt.FiguraVT"
    ],
    "figura_event": [
      "dev.exterminate.figuravt.EventPlugin"
    ]
  },
  "depends": {
    "fabric": "*",
    "minecraft": ">=1.20",
    "figura": ">=${figura_version}"
  }
