{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${display_name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "sources": "https://github.com/Exterminate5573/FiguraVT"
  },
  "license": "LGPL-2.1-or-later",
  "icon": "assets/examplemod/icon.png",
  "environment": "*",
